from collections import deque

def bfs_robot(graph, start, goal):
    queue, visited = deque([[start]]), {start}
    while queue:
        path = queue.popleft()
        if path[-1] == goal: return path
        for nxt in set(graph.get(path[-1], [])) - visited:
            visited.add(nxt)
            queue.append(path + [nxt])

# Building layout: level-wise room connections
building = {'Hall': ['Room101', 'Room102'], 'Room101': ['Hall', 'Room103'], 'Room102': ['Hall'], 'Room103': ['Room101']}
print("Shortest Path:", bfs_robot(building, 'Hall', 'Room103'))
